# AdvanDEB environment — copy to app/backend/.env and `chmod 600` it.
#
# ONE file configures everything: the web app (app/core/config.py), the KB
# library and agents (knowledge-builder/advandeb_kb/config/settings.py) and the
# ops scripts. All of them resolve each value the same way:
#   process environment  →  this file  →  code default
# (ADVANDEB_ENV_FILE=/path overrides the file location; ADVANDEB_ENV_FILE=""
# disables it — the test suite does that.)
#
# The agents do not inherit this whole file: scripts/run_component.py passes
# each one only the variables it uses (no JWT key, OAuth secret or shared
# chat API key).

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="AdvanDEB Modeling Assistant"
APP_VERSION="0.1.0"
# Anything other than "development" enforces a strong JWT_SECRET_KEY at
# startup (≥ 32 chars, not the example value). That validator is the only
# thing ENVIRONMENT changes; DEBUG is currently not read by any code.
# Production: ENVIRONMENT=production, DEBUG=False.
ENVIRONMENT=development
DEBUG=False
LOG_LEVEL=INFO
# Relative to app/backend/ (the unit's WorkingDirectory). Rotated by the app
# (10 MB × 5).
LOG_FILE=logs/app.log

# ── Server (informational — the bind address is set by uvicorn's --host in
# scripts/systemd/advandeb.service: 127.0.0.1, behind nginx) ──────────────────
HOST=127.0.0.1
PORT=8400
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Security ─────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# BYOK — Fernet key encrypting users' LLM API keys at rest. Must be RANDOM:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# never derived from a passphrase. Leave unset to disable BYOK.
# Rotating it: scripts/rotate_llm_key_encryption.py (uses _PREVIOUS below).
LLM_KEY_ENCRYPTION_KEY=
# Comma-separated retired keys still accepted for decryption during a rotation.
LLM_KEY_ENCRYPTION_KEY_PREVIOUS=

# Google OAuth 2.0 (optional — native login works without these)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8400/api/auth/callback

# GitHub "Connect with GitHub" device flow → GitHub Models (BYOK).
# Register your OWN GitHub App (https://github.com/settings/apps) with
# "Device Flow" enabled and the "Models: read" account permission; no client
# secret or callback is needed. Leave unset to hide the feature. This reaches
# GitHub MODELS (free, rate-limited), not a Copilot subscription.
GITHUB_OAUTH_CLIENT_ID=
# Classic OAuth Apps only (GitHub Apps ignore scope). Usually blank.
GITHUB_OAUTH_SCOPE=

# ── Shared default chat key (offered to users without their own key) ───────
DEFAULT_CHAT_API_KEY=
DEFAULT_CHAT_PROVIDER=nvidia
DEFAULT_CHAT_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Requests/minute shared by ALL users of the default key; keep within the
# key's own rate-limit tier.
DEFAULT_CHAT_RPM=40

# ── MongoDB ──────────────────────────────────────────────────────────────────
# With authentication enabled:
#   MONGODB_URI=mongodb://advandeb_app:<password>@127.0.0.1:27017/?authSource=admin
# (URL-encode special characters in the password.) The KB still accepts the
# old name MONGODB_URL as an alias; use MONGODB_URI.
MONGODB_URI=mongodb://localhost:27017
MONGO_MAX_POOL_SIZE=10
# App database: users, auth, chat, submissions. The KB's chat store follows
# it unless CHAT_STORE_DB_NAME says otherwise.
MONGODB_DB_NAME=advandeb
# KB workflow state + graph-artifact metadata (alias: DATABASE_NAME).
KB_DB_NAME=advandeb_knowledge_builder_kb
# CHAT_STORE_DB_NAME=advandeb
# Corpora used by expert-reference lookups:
# DEB_LITERATURE_DB=deb_literature_review
# DEB_REPRO_DB=deb_abstracts_reproduction

# ── ArangoDB — KB primary store ──────────────────────────────────────────────
ARANGO_URL=http://localhost:8529
ARANGO_DB_NAME=advandeb_kb
ARANGO_USERNAME=root
ARANGO_PASSWORD=your-arango-password-here

# ── Agents and gateway ───────────────────────────────────────────────────────
MCP_SERVER_URL=http://localhost:8080
MCP_SERVER_ENABLED=True
CHATBOT_AGENT_WS=ws://localhost:8086
RETRIEVAL_AGENT_WS=ws://localhost:8081

# ── Ollama (local models) ────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:latest
OLLAMA_NUM_CTX=16384

# ── Chat pipeline (KB / chatbot_agent) ───────────────────────────────────────
CHAT_MODE=react
CHAT_DEFAULT_TOP_K=8
CHAT_MAX_STEPS=15
CHAT_USE_RERANKING=True
CHAT_ENABLE_EXTERNAL_FALLBACK=True
# Adaptive thinking / reasoning effort on providers that support it:
# low | medium | high | max
CHAT_ADAPTIVE_THINKING=True
CHAT_THINKING_EFFORT=high
CHAT_ANSWER_MODEL=deepseek-r1:latest
CHAT_VERIFY_MODEL=deepseek-r1:latest
CHAT_GRAPH_MODEL=gemma3:latest
CHAT_FOLLOWUP_MODEL=gemma3:latest
CHAT_EXTERNAL_FALLBACK_MODEL=deepseek-r1:latest
CHAT_ANSWER_NUM_CTX=16384
CHAT_ANSWER_MAX_TOKENS=32000
CHAT_VERIFY_NUM_CTX=4096
CHAT_GRAPH_NUM_CTX=4096
CHAT_FOLLOWUP_NUM_CTX=2048
CHAT_EXTERNAL_NUM_CTX=16384

# ── KB ingestion, retrieval, graphs ──────────────────────────────────────────
# Source PDFs (default ~/DEB_library). Read by both the app and the KB.
# PAPERS_ROOT=/home/you/DEB_library
# 0 = size worker concurrency from available GPU/RAM/CPU at startup.
INGESTION_CONCURRENCY=0
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Default <repo>/data/chromadb (ChromaDB is being replaced by ArangoDB vectors).
# CHROMA_PERSIST_DIR=
CHROMA_COLLECTION=advandeb_chunks
# Polite-pool contact address sent to OpenAlex.
# OPENALEX_EMAIL=you@example.org
# Empty = Redis disabled; the cache falls back to an in-process LRU.
REDIS_URL=

# Graph artifacts (relative to app/backend/)
GRAPH_ARTIFACT_DIR=data/graph_artifacts
# Bump when a layout function changes shape, then rebuild artifacts.
GRAPH_ARTIFACT_LAYOUT_NAME=schema_default_v4
# Rebuild pacing: SETTLE coalesces bursts of mark-dirty calls; MIN_INTERVAL is
# the floor between two rebuilds of one schema (chat marks "chatbot" dirty on
# every message). MAX_NODES caps one rebuild's load (0 = unlimited).
GRAPH_ARTIFACT_REBUILD_SETTLE_SECONDS=5
GRAPH_ARTIFACT_REBUILD_MIN_INTERVAL_SECONDS=120
GRAPH_ARTIFACT_MAX_NODES=50000

# ── Elicitation (optional tuning) ────────────────────────────────────────────
# ELICITATION_HUMAN_PANEL_SIZE=5
# ELICITATION_COMPARISON_EVERY=25
# ELICITATION_EVIDENCE_PASSAGES=18

# ── Process / deployment (optional) ──────────────────────────────────────────
# FRONTEND_DIST=            # default app/frontend/dist
# FS_ROOT=~/dev             # root of the KB file browser
# BACKGROUND_WORKER=1       # force singleton background tasks on/off (1/0)
