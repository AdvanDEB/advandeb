# Environment Configuration

# Application
APP_NAME="AdvanDEB Modeling Assistant"
APP_VERSION="0.1.0"
DEBUG=True
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8400
RELOAD=True

# Security
JWT_SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# BYOK — Fernet key for encrypting user-supplied LLM API keys at rest.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave unset to disable the BYOK feature (the rest of the app still boots).
LLM_KEY_ENCRYPTION_KEY=

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8400/api/auth/callback

# Database — app layer (users, auth, chat, user submissions)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=advandeb

# Database — KB layer (documents, facts, taxonomy, graphs)
# KB_DB_NAME is transitional: used during MongoDB→ArangoDB migration, remove after.
KB_DB_NAME=advandeb_knowledge_builder_kb

# ArangoDB — KB primary store (set password after running: sudo arango password reset)
ARANGO_URL=http://localhost:8529
ARANGO_DB_NAME=advandeb_kb
ARANGO_USERNAME=root
ARANGO_PASSWORD=your-arango-password-here

# MCP Server (Rust gateway — port 8080)
MCP_SERVER_URL=http://localhost:8080
MCP_SERVER_ENABLED=True

# Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Chat pipeline
CHAT_STORE_DB_NAME=advandeb
CHAT_MODE=react
CHAT_DEFAULT_TOP_K=8
CHAT_ENABLE_EXTERNAL_FALLBACK=True
CHAT_ANSWER_MODEL=deepseek-r1:latest
CHAT_VERIFY_MODEL=deepseek-r1:latest
CHAT_GRAPH_MODEL=gemma3:latest
CHAT_FOLLOWUP_MODEL=gemma3:latest
CHAT_EXTERNAL_FALLBACK_MODEL=deepseek-r1:latest
CHAT_ANSWER_NUM_CTX=16384
CHAT_VERIFY_NUM_CTX=4096
CHAT_GRAPH_NUM_CTX=4096
CHAT_FOLLOWUP_NUM_CTX=2048
CHAT_EXTERNAL_NUM_CTX=16384

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Rate Limiting (optional)
RATE_LIMIT_ENABLED=False
REDIS_URL=redis://localhost:6379
