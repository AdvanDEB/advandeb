[Unit]
Description=AdvanDEB (web app + agent stack)
Documentation=file:///home/adeb/dev/advandeb/scripts/systemd/README.md
# `systemctl restart advandeb.target` restarts everything; each half stays
# independently restartable (advandeb.service, advandeb-stack.target).
Wants=advandeb-stack.target advandeb.service
After=advandeb-stack.target advandeb.service

[Install]
WantedBy=multi-user.target
