[Unit]
Description=AdvanDEB Background Stack (MCP Gateway + 6 AI Agents)
Documentation=file:///home/adeb/dev/advandeb/RUNNING.md
After=network.target mongod.service ollama.service
Wants=mongod.service ollama.service
# Group with the umbrella target so advandeb.target controls both halves.
PartOf=advandeb.target

[Service]
Type=forking
User=adeb
Group=adeb

# start_stack.sh launches all processes as detached children and returns.
# stop_stack.sh gracefully shuts them all down.
ExecStart=/home/adeb/dev/advandeb/scripts/start_stack.sh
ExecStop=/home/adeb/dev/advandeb/scripts/stop_stack.sh

# PIDFile is not used (we manage per-component PIDs ourselves) — use Type=forking
# so systemd considers the service started once start_stack.sh exits successfully.

# Give the stack up to 3 minutes to start (retrieval_agent loads embeddings).
TimeoutStartSec=180
TimeoutStopSec=30

# Restart the whole stack if it fails at start time.
Restart=on-failure
RestartSec=15

StandardOutput=append:/home/adeb/dev/advandeb/logs/stack.log
StandardError=append:/home/adeb/dev/advandeb/logs/stack.log

[Install]
WantedBy=multi-user.target
